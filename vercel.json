{
  "version": 2,
  "buildCommand": "pnpm install && pnpm build",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "apps/api/api/index.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "apps/api/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "apps/web/$1"
    }
  ]
}
